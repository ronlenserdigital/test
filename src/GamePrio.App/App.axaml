<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GamePrio.App.GameprioApp"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#0F1218" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#161A22" />
      <Setter Property="BorderBrush" Value="#2A313D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#868F9F" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#868F9F" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="#E7EAF0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#E8A057" />
      <Setter Property="Foreground" Value="#15181F" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F2B577" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#1C212B" />
      <Setter Property="Foreground" Value="#E7EAF0" />
      <Setter Property="BorderBrush" Value="#2A313D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#E7EAF0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Application.Styles>
</Application>
