<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GamePrio.App.HudWindow"
        Title="STRYKR HUD"
        Width="330" Height="230"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

  <!--
    No panel, no plate. Legibility over arbitrary game art comes from a hard black
    halo behind every glyph, so the readout works on snow and on a night map alike.
  -->
  <StackPanel Margin="20,16" Spacing="0">
    <StackPanel.Effect>
      <DropShadowEffect BlurRadius="7" Color="Black" Opacity="1" OffsetX="0" OffsetY="0" />
    </StackPanel.Effect>

    <TextBlock Text="STRYKR"
               FontFamily="Bahnschrift, Segoe UI Variable Display, Inter, sans-serif"
               FontSize="12" FontWeight="Bold" Foreground="#FF2A36" LetterSpacing="2.6" />

    <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,2,0,0">
      <TextBlock x:Name="FpsText" Text="--" FontSize="62" FontWeight="Bold" Foreground="#FFFFFF"
                 FontFamily="Bahnschrift, Consolas, monospace" LineHeight="66" />
      <TextBlock Text="FPS" FontSize="15" FontWeight="Bold" Foreground="#FF2A36"
                 FontFamily="Bahnschrift, Segoe UI Variable Display, Inter, sans-serif"
                 VerticalAlignment="Bottom" Margin="0,0,0,13" LetterSpacing="1.4" />
    </StackPanel>

    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,8,0,0">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="1% LOW" Classes="k" />
      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LowText" Text="--" Classes="v"
                 Foreground="#FF6069" FontWeight="Bold" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="FRAME" Classes="k" />
      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FrameTimeText" Text="--" Classes="v" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="STUTTER" Classes="k" />
      <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StutterText" Text="--" Classes="v" />

      <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU/RAM" Classes="k" />
      <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SystemText" Text="--" Classes="v" />
    </Grid>

    <TextBlock x:Name="NoteText" Text="" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFC53D"
               TextWrapping="Wrap" MaxWidth="290" Margin="0,10,0,0" LineHeight="17" />
  </StackPanel>

  <Window.Styles>
    <Style Selector="TextBlock.k">
      <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Display, Inter, sans-serif" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#B9BAC4" />
      <Setter Property="LetterSpacing" Value="1.1" />
      <Setter Property="Width" Value="94" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style Selector="TextBlock.v">
      <Setter Property="FontFamily" Value="Bahnschrift, Consolas, monospace" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
  </Window.Styles>
</Window>
