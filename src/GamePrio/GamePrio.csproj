<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>gameprio</AssemblyName>
    <RootNamespace>GamePrio</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Publishing the GUI passes a RID down to this reference; without this it would be
         treated as a self-contained exe, which a framework-dependent app cannot reference.
         Override on the command line for a standalone self-contained console build. -->
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <None Update="profile.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      PresentMon (Intel, MIT) is vendored and embedded so frame timing works out of the
      box. It is extracted next to the user's data on first use, with its licence beside
      it. Sourced from the official GitHub release; see docs for the SHA-256.
    -->
    <EmbeddedResource Include="tools\PresentMon.exe" LogicalName="GamePrio.Tools.PresentMon.exe" />
    <EmbeddedResource Include="tools\PresentMon-LICENSE.txt" LogicalName="GamePrio.Tools.PresentMon-LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="strykr" />
    <InternalsVisibleTo Include="gameprio.tests" />
  </ItemGroup>

</Project>
