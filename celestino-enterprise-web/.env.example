# Copy to .env.local for development. Never commit real values.

# Canonical site URL (no trailing slash). Production must be the apex domain.
NEXT_PUBLIC_SITE_URL=https://celestinoenterprise.com
# Set to "production" ONLY on the production Vercel environment. Controls robots/indexing.
NEXT_PUBLIC_SITE_ENV=development

# Supabase (contact submissions). Service role key is SERVER ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 measurement ID (optional; analytics load only when set).
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile (optional; bot mitigation on the contact form).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt for hashing client addresses used in rate limiting.
RATE_LIMIT_SALT=
